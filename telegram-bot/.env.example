# Telegram bot (server-side only). Never commit real values.
# Create the bot with @BotFather in Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

FIREBASE_PROJECT_ID=hualway
# Full service-account JSON on one line, or leave blank to use GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT=

# Telegram numeric user ids allowed to run staff commands (comma separated).
# Send /id to the bot to see your own id.
BOT_STAFF_IDS=
# Optional: staff phone numbers, so a linked staff account is recognised too.
BOT_STAFF_NUMBERS=

PORT=8080
LOG_LEVEL=info
RATE_LIMIT_MAX=12
RATE_LIMIT_WINDOW_MINUTES=10
BOT_TIMEZONE=Africa/Accra
BOT_BROADCAST_MAX=20
BOT_BROADCAST_DELAY_MS=1500
