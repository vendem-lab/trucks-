# Set true only when you want to run the local seeded preview.
VITE_USE_DEMO_DATA=false

# Firebase project used by the browser client (see src/lib/firebase.js).
VITE_FIREBASE_PROJECT_ID=hualway

# --- Arkesel SMS (server-side only) ---------------------------------------
# These are read by the Vercel / Netlify function, never by the browser.
# Create the key in the Arkesel dashboard after registering a sender ID.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=HAULWAY

# Optional overrides.
# ARKESEL_API_URL=https://sms.arkesel.com/api/v2/sms/send
# SMS_DRY_RUN=true simulates delivery without calling Arkesel (useful locally).
# SMS_MAX_RECIPIENTS caps a single request (default 100, hard limit 200).
SMS_DRY_RUN=false
SMS_MAX_RECIPIENTS=100

# Project used by the serverless function to verify Firebase ID tokens.
# Falls back to VITE_FIREBASE_PROJECT_ID, then "hualway".
FIREBASE_PROJECT_ID=hualway
