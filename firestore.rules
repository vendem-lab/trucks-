rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function memberDoc(uid) { return /databases/$(database)/documents/members/$(uid); }
    function eventDoc(id) { return /databases/$(database)/documents/events/$(id); }
    function isStaff() {
      return signedIn()
        && exists(userDoc(request.auth.uid))
        && get(userDoc(request.auth.uid)).data.role == 'staff';
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isActiveMember(uid) {
      return signedIn()
        && exists(memberDoc(uid))
        && get(memberDoc(uid)).data.status == 'active';
    }
    function validFleet(data, memberId) {
      return data.keys().hasOnly([
          'memberId', 'displayName', 'vehicleType', 'region', 'city',
          'tier', 'joinedAt', 'photo', 'active', 'updatedAt'
        ])
        && data.memberId == memberId
        && data.active == true
        && data.photo is string
        && data.photo.size() < 900000
        && (data.photo.matches('^data:image/(jpeg|png|webp);base64,.+')
          || data.photo.matches('^/fleet/[a-z-]+\\.svg$'));
    }
    function validLoadRequest(data) {
      return data.keys().hasOnly([
          'reference', 'title', 'shipper', 'contactName', 'contactPhone',
          'contactEmail', 'origin', 'destination', 'vehicleType', 'weightTons',
          'rate', 'pickupDate', 'deliveryDate', 'requirements', 'status',
          'source', 'createdAt'
        ])
        && data.status == 'pending'
        && data.source == 'public'
        && data.reference is string
        && data.reference.size() <= 40
        && data.reference.matches('^LR-[0-9-]+$')
        && data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 120
        && data.shipper is string
        && data.shipper.size() >= 2
        && data.shipper.size() <= 120
        && data.contactName is string
        && data.contactName.size() >= 2
        && data.contactName.size() <= 120
        && data.contactPhone is string
        && data.contactPhone.size() >= 7
        && data.contactPhone.size() <= 40
        && data.contactEmail is string
        && data.contactEmail.size() <= 160
        && data.contactEmail.matches('^[^@]+@[^@]+[.][^@]+$')
        && data.origin is string
        && data.origin.size() >= 2
        && data.origin.size() <= 80
        && data.destination is string
        && data.destination.size() >= 2
        && data.destination.size() <= 80
        && data.vehicleType in [
          '1-tonne truck', '2-tonne truck', '3-tonne truck', '4-tonne truck',
          '5-tonne truck', 'Dry van', 'Reefer', 'Flatbed', 'Tanker',
          'Curtain-side', 'Tipper', 'Low bed', 'Bus / passenger'
        ]
        && data.weightTons is number
        && data.weightTons > 0
        && data.weightTons <= 100
        && data.rate is number
        && data.rate > 0
        && data.rate <= 1000000
        && data.pickupDate is string
        && data.pickupDate.size() == 10
        && data.deliveryDate is string
        && data.deliveryDate.size() <= 10
        && data.requirements is string
        && data.requirements.size() <= 600
        && data.createdAt is string
        && data.createdAt.size() <= 40;
    }
    function hasShipperContact(data) {
      return data.keys().hasAny(['contactName', 'contactPhone', 'contactEmail']);
    }
    function loadPath(id) { return /databases/$(database)/documents/loads/$(id); }
    function contactPath(id) { return /databases/$(database)/documents/loadContacts/$(id); }
    function deliveryPath(id) { return /databases/$(database)/documents/deliveries/$(id); }
    function validDelivery(data) {
      return data.keys().hasOnly([
          'loadId', 'loadReference', 'memberId', 'memberName', 'deliveredAt',
          'note', 'photo', 'status', 'confirmedAt', 'confirmedBy',
          'confirmationSource', 'shipperNote', 'shipperContact', 'shipperConfirmedAt'
        ])
        && data.status == 'submitted'
        && data.confirmedAt == ''
        && data.confirmedBy == ''
        && data.memberId is string
        && data.memberName is string
        && data.memberName.size() >= 2
        && data.memberName.size() <= 120
        && data.deliveredAt is string
        && data.deliveredAt.size() <= 40
        && data.note is string
        && data.note.size() >= 5
        && data.note.size() <= 600
        && data.photo is string
        && data.photo.size() < 900000
        && (data.photo == ''
          || data.photo.matches('^data:image/(jpeg|png|webp);base64,.+'));
    }
    function validDeliveryConfirmation(data) {
      return data.keys().hasOnly([
          'loadId', 'loadReference', 'outcome', 'note', 'contactEmail',
          'status', 'createdAt'
        ])
        && data.status == 'pending'
        && data.outcome in ['delivered', 'problem']
        && data.loadId is string
        && data.loadReference is string
        && data.loadReference.size() <= 40
        && data.loadReference.matches('^LD-[0-9-]+$')
        && data.contactEmail is string
        && data.contactEmail.size() <= 160
        && data.contactEmail.matches('^[^@]+@[^@]+[.][^@]+$')
        && data.note is string
        && data.note.size() <= 600
        && data.createdAt is string
        && data.createdAt.size() <= 40;
    }

    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.role == 'member'
        && request.resource.data.memberStatus == 'pending';
      allow read: if isSelf(uid) || isStaff();
      allow update: if isStaff()
        || (isSelf(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.memberStatus == resource.data.memberStatus
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isStaff();
    }

    match /members/{uid} {
      allow create: if isStaff()
        && request.resource.data.uid == uid
        && request.resource.data.status == 'active';
      allow list: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      allow get: if isStaff() || isSelf(uid);
      // Members may only maintain the profile fields exposed in the portal.
      allow update: if isStaff()
        || (isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'phone', 'region', 'city', 'vehicleType', 'vehiclePlate',
            'licenseNumber', 'emergencyName', 'emergencyPhone', 'notes', 'updatedAt'
          ]));
      allow delete: if isStaff();
    }
    match /fleet/{memberId} {
      allow read: if true;
      allow create: if isStaff()
        || (isSelf(memberId)
          && isActiveMember(memberId)
          && validFleet(request.resource.data, memberId));
      allow update: if isStaff()
        || (isSelf(memberId)
          && isActiveMember(memberId)
          && validFleet(request.resource.data, memberId));
      allow delete: if isStaff() || isSelf(memberId);
    }
    match /applications/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['password', 'role']);
      // Applicants can correct or resubmit their own pending application.
      allow update: if isStaff()
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && !request.resource.data.keys().hasAny(['password', 'role']));
      allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if false;
    }
    match /counters/{id} {
      allow read, write: if false;
    }

    match /loads/{id} {
      allow read: if true;
      // Shipper contact details live in loadContacts so the public board never
      // carries phone numbers or email addresses.
      allow create: if isStaff() && !hasShipperContact(request.resource.data);
      allow delete: if isStaff();
      allow update: if (isStaff() && !hasShipperContact(request.resource.data))
        // Active members claim an open load by writing only the claim fields.
        || (isActiveMember(request.auth.uid)
          && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'filledBy', 'filledById', 'filledAt'
          ])
          && request.resource.data.status == 'filled'
          && request.resource.data.filledById == request.auth.uid)
        // The claiming driver marks the load delivered and records the
        // delivery evidence in the same transaction.
        || (isActiveMember(request.auth.uid)
          && resource.data.status == 'filled'
          && resource.data.filledById == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'deliveredAt'
          ])
          && request.resource.data.status == 'delivered'
          && existsAfter(deliveryPath(id)));
    }
    match /loadContacts/{loadId} {
      // Contact details are never public. Signed-in users may read them, and
      // the interface only displays them to active members. Staff maintain them.
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }
    match /deliveries/{loadId} {
      allow read: if isStaff()
        || (signedIn()
          && exists(loadPath(loadId))
          && get(loadPath(loadId)).data.get('filledById', '') == request.auth.uid);
      // Only the driver who claimed the load may record its delivery, and only
      // while the load is still waiting on that delivery.
      allow create: if isActiveMember(request.auth.uid)
        && request.resource.data.loadId == loadId
        && request.resource.data.memberId == request.auth.uid
        && exists(loadPath(loadId))
        && get(loadPath(loadId)).data.get('status', '') == 'filled'
        && get(loadPath(loadId)).data.get('filledById', '') == request.auth.uid
        && validDelivery(request.resource.data);
      allow update, delete: if isStaff();
    }
    match /deliveryConfirmations/{id} {
      // Shippers confirm anonymously: the load reference and the contact email
      // on the private loadContacts document act as the two factors.
      allow create: if validDeliveryConfirmation(request.resource.data)
        && exists(loadPath(request.resource.data.loadId))
        && get(loadPath(request.resource.data.loadId)).data.get('status', '') == 'delivered'
        && get(loadPath(request.resource.data.loadId)).data.get('reference', '')
          == request.resource.data.loadReference
        && exists(contactPath(request.resource.data.loadId))
        && get(contactPath(request.resource.data.loadId)).data.get('contactEmail', '')
          == request.resource.data.contactEmail;
      allow read, update: if isStaff();
      allow delete: if isStaff();
    }
    match /loadRequests/{id} {
      // Anyone may submit a load for review, but only staff can read or
      // change the queue. Approval creates the public load document.
      allow create: if validLoadRequest(request.resource.data);
      allow read, update, delete: if isStaff();
    }
    match /news/{id} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }
    match /events/{id} {
      allow read: if true;
      allow create, delete: if isStaff();
      // Members may only add one to the counter, in the same transaction as
      // their own registration. Staff keep full control of the event document.
      allow update: if isStaff()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registered'])
          && request.resource.data.registered == resource.data.get('registered', 0) + 1
          && !exists(/databases/$(database)/documents/registrations/$(id + '_' + request.auth.uid))
          && existsAfter(/databases/$(database)/documents/registrations/$(id + '_' + request.auth.uid))
          && (!resource.data.get('memberOnly', false) || isActiveMember(request.auth.uid))
          && (resource.data.get('capacity', 0) == 0
            || resource.data.get('registered', 0) < resource.data.get('capacity', 0)));
    }
    match /dues/{id} {
      allow list: if isStaff() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow get: if isStaff() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create, delete: if isStaff();
      // Members can settle their own outstanding invoice; staff can adjust any.
      allow update: if isStaff()
        || (signedIn()
          && resource.data.memberId == request.auth.uid
          && resource.data.status in ['due', 'overdue']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'paidAt', 'method', 'note'
          ])
          && request.resource.data.status == 'paid'
          && request.resource.data.method in ['momo', 'bank', 'cash']);
    }
    match /alerts/{id} {
      allow list, get: if isStaff() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create: if signedIn()
        && isActiveMember(request.auth.uid)
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'memberId', 'name', 'email', 'phone', 'origin', 'destination',
          'trailerType', 'minRate', 'frequency', 'active', 'createdAt'
        ])
        && request.resource.data.active == true
        && request.resource.data.minRate is number
        && request.resource.data.minRate >= 0
        && request.resource.data.frequency in ['instant', 'daily', 'weekly']
        && (request.resource.data.origin != ''
          || request.resource.data.destination != ''
          || request.resource.data.trailerType != 'Any');
      allow update: if signedIn()
        && resource.data.memberId == request.auth.uid
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'origin', 'destination', 'trailerType', 'minRate', 'frequency', 'active', 'updatedAt'
        ])
        && request.resource.data.minRate is number
        && request.resource.data.minRate >= 0
        && request.resource.data.frequency in ['instant', 'daily', 'weekly']
        && request.resource.data.active is bool;
      allow delete: if signedIn() && resource.data.memberId == request.auth.uid;
    }
    match /registrations/{registrationId} {
      allow list: if isStaff() || (signedIn() && resource.data.memberId == request.auth.uid);
      // The registration transaction reads this document before creating it,
      // so a signed-in member may probe their own (possibly missing) record.
      allow get: if isStaff()
        || (signedIn() && (resource == null || resource.data.memberId == request.auth.uid));
      allow create: if signedIn()
        && registrationId == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'eventId', 'eventTitle', 'memberId', 'name', 'email', 'phone', 'createdAt'
        ])
        && exists(eventDoc(request.resource.data.eventId))
        && request.resource.data.eventTitle
          == get(eventDoc(request.resource.data.eventId)).data.get('title', '')
        && (!get(eventDoc(request.resource.data.eventId)).data.get('memberOnly', false)
          || isActiveMember(request.auth.uid))
        && (get(eventDoc(request.resource.data.eventId)).data.get('capacity', 0) == 0
          || get(eventDoc(request.resource.data.eventId)).data.get('registered', 0)
            < get(eventDoc(request.resource.data.eventId)).data.get('capacity', 0));
      allow update: if false;
      allow delete: if isStaff();
    }
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'email', 'phone', 'type', 'subject', 'message', 'read', 'createdAt'
      ]) && request.resource.data.read == false;
      allow read, update, delete: if isStaff();
    }
    match /notificationFailures/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
