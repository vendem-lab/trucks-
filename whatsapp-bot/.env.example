# WhatsApp bot (server-side only). Never commit real values.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

FIREBASE_PROJECT_ID=hualway
# Full service-account JSON on one line, or leave blank to use GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT=

# Firestore document id that stores the linked-device session.
WHATSAPP_SESSION_ID=haulway
# Bot number in international format, digits only (used for the pairing code).
WHATSAPP_PAIRING_NUMBER=233XXXXXXXXX

PORT=8080
LOG_LEVEL=info
RATE_LIMIT_MAX=12
RATE_LIMIT_WINDOW_MINUTES=10
BOT_TIMEZONE=Africa/Accra

# Comma-separated staff numbers allowed to run ! commands (digits only).
BOT_STAFF_NUMBERS=
# Safety limits for !broadcast (personal numbers get banned for bulk sending).
BOT_BROADCAST_MAX=20
BOT_BROADCAST_DELAY_MS=1500
